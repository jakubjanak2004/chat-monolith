# Copy to ".env" for local development:
#   cp .env.example .env
#
# The app already uses these properties (see src/main/resources/local.properties),
# but Docker should not rely on committed secrets files. Spring maps env vars to
# properties automatically (e.g. APP_JWT_SECRET -> app.jwt.secret).
#

############################
# App / server
############################
SERVER_PORT=8090

############################
# JWT / security (REQUIRED)
############################
# IMPORTANT:
# - `app.jwt.secret` is BASE64-decoded in `SecurityConfig.jwtSecret()`.
# - So this value MUST be valid base64 (otherwise you'll see: "Illegal base64 character ...").
# Generate a strong one for local/prod, e.g.:
#   openssl rand -base64 32
APP_JWT_SECRET=qLvc1G3v0+5m4Y7p2K3E9m6s1Vv1R3g2V7Ew0yJv1sw=
APP_JWT_ALGO=HS256
APP_JWT_ISSUER=https://project-chat.local
#
# IMPORTANT: Your Spring @ConfigurationProperties record uses fields named
# `accessTTL` and `refreshTTL` (camelCase). For env vars, the most reliable
# binding is to use the same tokenization (no extra underscore between ACCESS and TTL):
APP_JWT_ACCESSTTL=2h
APP_JWT_REFRESHTTL=7d

# Argon2 settings (optional; defaults come from your local.properties if you set them)
APP_SECURITY_SALT_LENGTH=16
APP_SECURITY_HASH_LENGTH=32
APP_SECURITY_PARALLELISM=1
APP_SECURITY_MEMORY_KB=65536
APP_SECURITY_ITERATIONS=3

############################
# Database (optional)
############################
# The repo defaults to an in-memory H2 DB:
#   spring.datasource.url=jdbc:h2:mem:testdb
#
# For local persistence in Docker, you can switch to a file-based H2 URL:
# SPRING_DATASOURCE_URL=jdbc:h2:file:/data/testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

############################
# MinIO (REQUIRED for profile pictures)
############################
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=pictures
MINIO_REGION=us-east-1

############################
# Mail (optional)
############################
# In docker-compose.yml we run Mailpit and point Spring Mail to it automatically.
# - SMTP: localhost:1025
# - Web UI: http://localhost:8025
#
# If you run outside compose (or want real SMTP), set:
SPRING_MAIL_HOST=in-v3.mailjet.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=2c60a1fe0ace46314d4a76175b56b627
SPRING_MAIL_PASSWORD=c4b1548bf28f332fb335f15e8f443604
APP_MAIL_FROM=jakubjanak2004@gmail.com

############################
# Seeding (optional)
############################
APP_SEED_ADMIN_ENABLED=true
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=admin
APP_SEED_ADMIN_EMAIL=admin@gmail.com
APP_SEED_ADMIN_FIRST_NAME=Bob
APP_SEED_ADMIN_LAST_NAME=Smith
APP_SEED_ADMIN_NUM_OF_MESSAGES=100
APP_SEED_ADMIN_MESSAGE_WORD_COUNT_FROM=3
APP_SEED_ADMIN_MESSAGE_WORD_COUNT_TO=100

APP_SEED_USERS_ENABLED=true
APP_SEED_USERS_COUNT=100
APP_SEED_USERS_PASSWORD=admin

############################
# WebSocket (optional)
############################
# Your app validates `app.websocket.allowedOrigins` as @NotEmpty.
# In `docker-compose.yml` we set it via SPRING_APPLICATION_JSON.
# If you run the jar directly (no compose), you can set it as:
# APP_WEBSOCKET_ALLOWEDORIGINS_0=http://localhost:8081
# APP_WEBSOCKET_ALLOWEDORIGINS_1=http://127.0.0.1:8081
