        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(k6_scenario_active_vus{scenario=\"ws_receivers\"})",
          "legendFormat": "WS receivers (VUs)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "k6 active VUs by scenario (custom Gauge — shared Y-axis)",
      "type": "timeseries"
    },
    {
