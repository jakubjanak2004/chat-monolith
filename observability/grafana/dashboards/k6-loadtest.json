  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Virtual users currently active.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum(k6_vus{job=\"k6\"})",
          "legendFormat": "vus",
          "refId": "A"
        }
      ],
      "title": "k6 VUs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "HTTP requests per second generated by k6.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs{job=\"k6\"}[1m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "title": "k6 HTTP RPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "k6 error rate from http_req_failed.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "100 * (sum(rate(k6_http_req_failed{job=\"k6\"}[1m])) / sum(rate(k6_http_reqs{job=\"k6\"}[1m])))",
          "legendFormat": "failed %",
          "refId": "A"
        }
      ],
      "title": "k6 HTTP failed (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "k6 end-to-end request duration quantiles (overall).",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(k6_http_req_duration_seconds_bucket{job=\"k6\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_seconds_bucket{job=\"k6\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(k6_http_req_duration_seconds_bucket{job=\"k6\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "k6 HTTP duration p50/p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "k6 request duration p95 by request name (tags.name).",
      "fieldConfig": {
        "defaults": { "unit": "s", "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(k6_http_req_duration_seconds_bucket{job=\"k6\"}[5m])))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "k6 HTTP duration p95 (by name)",
      "type": "timeseries"
    }
  ],
