      "targets": [
        {
          "expr": "process_start_time_seconds{job=\"chat-monolith\"} * 1000",
          "legendFormat": "start",
          "refId": "A"
        }
      ],
      "title": "Process start time",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "JVM used heap memory.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1073741824 },
              { "color": "red", "value": 2147483648 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"chat-monolith\", area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=\"chat-monolith\", area=\"heap\"})",
          "legendFormat": "heap max",
          "refId": "B"
        }
      ],
      "title": "JVM heap (used / max)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
