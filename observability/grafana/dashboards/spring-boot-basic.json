    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Endpoint p95 latency over the last 5 minutes (highest-cardinality view; best for finding hotspots).",
      "fieldConfig": {
        "defaults": { "unit": "s", "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
