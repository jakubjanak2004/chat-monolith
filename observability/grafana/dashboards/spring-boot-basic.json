      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Whether Prometheus can scrape the backend.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "expr": "up{job=\"chat-monolith\"}",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "title": "Backend scrape (up)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Spring Boot start time (seconds since epoch).",
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
